<Window x:Class="ScreenText.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenText Settings" Width="480" Height="570" WindowStartupLocation="CenterScreen"
        Background="#FFF8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="48" Height="48" CornerRadius="12" Background="#FF2563EB" Margin="0,0,12,0">
                    <Grid>
                        <Ellipse Width="19" Height="19" Stroke="White" StrokeThickness="3" Margin="0,0,8,8"/>
                        <Line X1="28" Y1="28" X2="37" Y2="37" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#FFBFDBFE" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ScreenText" FontSize="24" FontWeight="Bold" Foreground="#FF172033"/>
                    <TextBlock Text="Select text. Copy instantly." FontSize="13" Foreground="#FF64748B"/>
                </StackPanel>
            </StackPanel>

            <Border Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="How to use ScreenText" FontWeight="SemiBold" Foreground="#FF1E3A8A"/>
                    <TextBlock Text="Press your shortcut, then drag over any text on the screen. Release the mouse button and the recognized text will be copied to the Clipboard." TextWrapping="Wrap" Foreground="#FF334155" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Capture shortcut" FontSize="16" FontWeight="SemiBold" Foreground="#FF172033" Margin="0,0,0,5"/>
            <TextBlock Text="Click the key field and press the combination you want to use." Foreground="#FF64748B" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,8">
                <CheckBox x:Name="WinModifierCheckBox" Content="Win" Margin="0,0,14,0" Checked="ModifierChanged" Unchecked="ModifierChanged"/>
                <CheckBox x:Name="ShiftModifierCheckBox" Content="Shift" Margin="0,0,14,0" Checked="ModifierChanged" Unchecked="ModifierChanged"/>
                <CheckBox x:Name="CtrlModifierCheckBox" Content="Ctrl" Margin="0,0,14,0" Checked="ModifierChanged" Unchecked="ModifierChanged"/>
                <CheckBox x:Name="AltModifierCheckBox" Content="Alt" Checked="ModifierChanged" Unchecked="ModifierChanged"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Key" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#FF334155"/>
                <TextBox x:Name="HotkeyKeyTextBox" Width="90" MaxLength="12" Padding="7,4" PreviewKeyDown="HotkeyKeyTextBoxPreviewKeyDown" TextChanged="HotkeyKeyTextBoxTextChanged"/>
            </StackPanel>
            <TextBlock Text="Current shortcut:" Foreground="#FF64748B"/>
            <TextBlock x:Name="HotkeyPreviewText" FontSize="16" FontWeight="SemiBold" Foreground="#FF2563EB" Margin="0,2,0,22"/>

            <TextBlock Text="Recognition" FontSize="16" FontWeight="SemiBold" Foreground="#FF172033" Margin="0,0,0,8"/>
            <TextBlock Text="Language models" Foreground="#FF334155"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,4">
                <TextBox x:Name="LanguageTextBox" Width="310" Padding="7,4" ToolTip="Examples: eng+rus, spa+chi_sim, or auto"/>
                <Button Content="Add model..." Padding="9,4" Margin="8,0,0,0" Click="AddLanguageModelClick"/>
            </StackPanel>
            <TextBlock Text="Examples: eng+rus or spa+chi_sim. Auto requires osd.traineddata and matching local models." TextWrapping="Wrap" Foreground="#FF64748B" Margin="0,0,0,16"/>

            <CheckBox x:Name="AutoCopyCheckBox" Content="Copy recognized text automatically" IsChecked="True" Margin="0,0,0,10"/>
            <CheckBox x:Name="ShowNotificationCheckBox" Content="Show notifications" IsChecked="True" Margin="0,0,0,10"/>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start ScreenText with Windows" Margin="0,0,0,20"/>

            <TextBlock x:Name="StatusText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save changes" Padding="14,7" Margin="0,0,8,0" Click="SaveClick"/>
                <Button Content="Cancel" Padding="14,7" Click="CancelClick"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
