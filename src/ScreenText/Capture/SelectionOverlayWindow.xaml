<Window x:Class="ScreenText.Capture.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="#01000000" Topmost="True"
        Focusable="True" Cursor="Cross">
    <Grid Background="#52000000">
        <Canvas x:Name="RootCanvas" Background="Transparent">
            <Rectangle x:Name="SelectionRectangle" Stroke="#FF4DA3FF" StrokeThickness="2" Fill="#334DA3FF" Visibility="Collapsed"/>
        </Canvas>
        <Border x:Name="InstructionBorder" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,28,0,0" Padding="18,10" Background="#E8172433"
                BorderBrush="#FF4DA3FF" BorderThickness="1" CornerRadius="8"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✚" Foreground="#FF8AC7FF" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Select an area with text" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Drag with the mouse  •  Esc to cancel" Foreground="#FFD6E5F2" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
